# Copy this file to .env.local and fill it in.

# Supabase (free plan): open your project, click "Connect", choose "Transaction pooler"
# (port 6543, works on any internet connection) and paste the URI here with your
# database password in place of [YOUR-PASSWORD]. If the password has symbols like @ # / ?,
# reset it to letters and numbers only, or URL-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Login (Supabase Auth, free). Project Settings > API Keys: the project URL and the "Publishable key"
# (sb_publishable_..., or the older "anon" key). Both stay on the server. Add users in Authentication > Users.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# true shows "Reset demo data" in the sidebar. Set it to false once you start entering real data.
ALLOW_DEMO_RESET=true
